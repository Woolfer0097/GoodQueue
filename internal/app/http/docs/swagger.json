{
    "consumes": [
        "application/json"
    ],
    "produces": [
        "application/json"
    ],
    "schemes": [
        "http"
    ],
    "swagger": "2.0",
    "info": {
        "description": "Backend skeleton for a fair purchase queue. Business operations currently return a deterministic 501 response.",
        "title": "GoodQueue API",
        "contact": {},
        "version": "0.1.0"
    },
    "basePath": "/",
    "paths": {
        "/api/v1/products": {
            "get": {
                "description": "Reserved business contract; returns 501 until product listing is implemented.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "products"
                ],
                "summary": "List products",
                "parameters": [
                    {
                        "maxLength": 255,
                        "type": "string",
                        "description": "Trusted external user identity supplied by upstream authentication",
                        "name": "X-User-ID",
                        "in": "header"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/handler.ProductResponse"
                            }
                        }
                    },
                    "501": {
                        "description": "Not Implemented",
                        "schema": {
                            "$ref": "#/definitions/middleware.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/products/{productID}": {
            "get": {
                "description": "Reserved business contract; returns 501 until product lookup is implemented.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "products"
                ],
                "summary": "Get a product",
                "parameters": [
                    {
                        "maxLength": 255,
                        "type": "string",
                        "description": "Trusted external user identity supplied by upstream authentication",
                        "name": "X-User-ID",
                        "in": "header"
                    },
                    {
                        "type": "string",
                        "format": "uuid",
                        "description": "Product UUID",
                        "name": "productID",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handler.ProductResponse"
                        }
                    },
                    "501": {
                        "description": "Not Implemented",
                        "schema": {
                            "$ref": "#/definitions/middleware.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/products/{productID}/checkout-authorizations": {
            "post": {
                "description": "Future authorization uses the trusted external user ID, product ID, and an active database purchase right. No bearer purchase token is accepted. Currently returns 501 without querying or mutating PostgreSQL.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "checkout"
                ],
                "summary": "Authorize checkout",
                "parameters": [
                    {
                        "maxLength": 255,
                        "type": "string",
                        "description": "Trusted external user identity supplied by upstream authentication",
                        "name": "X-User-ID",
                        "in": "header"
                    },
                    {
                        "type": "string",
                        "format": "uuid",
                        "description": "Product UUID",
                        "name": "productID",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handler.CheckoutAuthorizationResponse"
                        }
                    },
                    "501": {
                        "description": "Not Implemented",
                        "schema": {
                            "$ref": "#/definitions/middleware.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/products/{productID}/queue-entries": {
            "post": {
                "description": "Reserved business contract; returns 501 without parsing input or changing PostgreSQL.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "queue"
                ],
                "summary": "Join a product queue",
                "parameters": [
                    {
                        "maxLength": 255,
                        "type": "string",
                        "description": "Trusted external user identity supplied by upstream authentication",
                        "name": "X-User-ID",
                        "in": "header"
                    },
                    {
                        "type": "string",
                        "format": "uuid",
                        "description": "Product UUID",
                        "name": "productID",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Queue join idempotency key; future persistence is unique per external user",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/handler.JoinQueueRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/handler.QueueEntryResponse"
                        }
                    },
                    "501": {
                        "description": "Not Implemented",
                        "schema": {
                            "$ref": "#/definitions/middleware.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/products/{productID}/queue-entry": {
            "get": {
                "description": "Reserved business contract; returns 501 without querying PostgreSQL.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "queue"
                ],
                "summary": "Get the current queue entry",
                "parameters": [
                    {
                        "maxLength": 255,
                        "type": "string",
                        "description": "Trusted external user identity supplied by upstream authentication",
                        "name": "X-User-ID",
                        "in": "header"
                    },
                    {
                        "type": "string",
                        "format": "uuid",
                        "description": "Product UUID",
                        "name": "productID",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handler.QueueEntryResponse"
                        }
                    },
                    "501": {
                        "description": "Not Implemented",
                        "schema": {
                            "$ref": "#/definitions/middleware.ErrorResponse"
                        }
                    }
                }
            },
            "delete": {
                "description": "Reserved business contract; returns 501 without mutating PostgreSQL.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "queue"
                ],
                "summary": "Leave the current product queue",
                "parameters": [
                    {
                        "maxLength": 255,
                        "type": "string",
                        "description": "Trusted external user identity supplied by upstream authentication",
                        "name": "X-User-ID",
                        "in": "header"
                    },
                    {
                        "type": "string",
                        "format": "uuid",
                        "description": "Product UUID",
                        "name": "productID",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "204": {
                        "description": "No Content"
                    },
                    "501": {
                        "description": "Not Implemented",
                        "schema": {
                            "$ref": "#/definitions/middleware.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/healthz": {
            "get": {
                "description": "Reports that the HTTP process is serving; does not check dependencies.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "infrastructure"
                ],
                "summary": "Liveness probe",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handler.HealthResponse"
                        }
                    }
                }
            }
        },
        "/readyz": {
            "get": {
                "description": "Reports whether PostgreSQL responds within the configured timeout. Dependency errors are never exposed.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "infrastructure"
                ],
                "summary": "Readiness probe",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handler.HealthResponse"
                        }
                    },
                    "503": {
                        "description": "Service Unavailable",
                        "schema": {
                            "$ref": "#/definitions/handler.HealthResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "domain.PurchaseRightStatus": {
            "type": "string",
            "enum": [
                "active",
                "expired",
                "consumed"
            ],
            "x-enum-varnames": [
                "PurchaseRightActive",
                "PurchaseRightExpired",
                "PurchaseRightConsumed"
            ]
        },
        "domain.QueueEntryStatus": {
            "type": "string",
            "enum": [
                "waiting",
                "right_issued",
                "completed",
                "cancelled",
                "expired"
            ],
            "x-enum-varnames": [
                "QueueEntryWaiting",
                "QueueEntryRightIssued",
                "QueueEntryCompleted",
                "QueueEntryCancelled",
                "QueueEntryExpired"
            ]
        },
        "handler.CheckoutAuthorizationResponse": {
            "type": "object",
            "required": [
                "expires_at",
                "issued_at",
                "purchase_right_id",
                "queue_ticket_id",
                "status"
            ],
            "properties": {
                "expires_at": {
                    "type": "string",
                    "format": "date-time"
                },
                "issued_at": {
                    "type": "string",
                    "format": "date-time"
                },
                "purchase_right_id": {
                    "type": "string",
                    "format": "uuid"
                },
                "queue_ticket_id": {
                    "type": "integer",
                    "example": 42
                },
                "status": {
                    "enum": [
                        "active",
                        "expired",
                        "consumed"
                    ],
                    "allOf": [
                        {
                            "$ref": "#/definitions/domain.PurchaseRightStatus"
                        }
                    ],
                    "example": "active"
                }
            }
        },
        "handler.HealthResponse": {
            "type": "object",
            "required": [
                "status"
            ],
            "properties": {
                "status": {
                    "type": "string",
                    "example": "ok"
                }
            }
        },
        "handler.JoinQueueRequest": {
            "type": "object",
            "required": [
                "idempotency_key"
            ],
            "properties": {
                "idempotency_key": {
                    "type": "string",
                    "format": "uuid",
                    "example": "7ae799c1-0dfa-4248-b80b-4e60e61f431d"
                }
            }
        },
        "handler.ProductResponse": {
            "type": "object",
            "required": [
                "allocatable_stock",
                "description",
                "id",
                "image_url",
                "queue_enabled",
                "right_ttl_seconds",
                "title"
            ],
            "properties": {
                "allocatable_stock": {
                    "type": "integer",
                    "minimum": 0,
                    "example": 10
                },
                "description": {
                    "type": "string",
                    "example": "A scarce product offered through a fair queue."
                },
                "id": {
                    "type": "string",
                    "format": "uuid",
                    "example": "f3cfd11c-a3d1-4ae4-a8b1-d3bc2e891bc7"
                },
                "image_url": {
                    "type": "string",
                    "format": "uri",
                    "example": "https://example.invalid/product.jpg"
                },
                "queue_enabled": {
                    "type": "boolean",
                    "example": true
                },
                "right_ttl_seconds": {
                    "type": "integer",
                    "maximum": 86400,
                    "minimum": 30,
                    "example": 600
                },
                "title": {
                    "type": "string",
                    "example": "Limited Edition Item"
                }
            }
        },
        "handler.QueueEntryResponse": {
            "type": "object",
            "required": [
                "joined_at",
                "product_id",
                "status",
                "ticket_id"
            ],
            "properties": {
                "cancelled_at": {
                    "type": "string",
                    "format": "date-time"
                },
                "completed_at": {
                    "type": "string",
                    "format": "date-time"
                },
                "expired_at": {
                    "type": "string",
                    "format": "date-time"
                },
                "joined_at": {
                    "type": "string",
                    "format": "date-time"
                },
                "product_id": {
                    "type": "string",
                    "format": "uuid"
                },
                "right_issued_at": {
                    "type": "string",
                    "format": "date-time"
                },
                "status": {
                    "enum": [
                        "waiting",
                        "right_issued",
                        "completed",
                        "cancelled",
                        "expired"
                    ],
                    "allOf": [
                        {
                            "$ref": "#/definitions/domain.QueueEntryStatus"
                        }
                    ],
                    "example": "waiting"
                },
                "ticket_id": {
                    "type": "integer",
                    "example": 42
                }
            }
        },
        "middleware.ErrorBody": {
            "type": "object",
            "required": [
                "code",
                "message"
            ],
            "properties": {
                "code": {
                    "type": "string",
                    "example": "not_implemented"
                },
                "message": {
                    "type": "string",
                    "example": "not implemented"
                }
            }
        },
        "middleware.ErrorResponse": {
            "type": "object",
            "required": [
                "error"
            ],
            "properties": {
                "error": {
                    "$ref": "#/definitions/middleware.ErrorBody"
                }
            }
        }
    }
}