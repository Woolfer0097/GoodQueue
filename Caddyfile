:8088 {
	handle /api/readyz {
		rewrite * /readyz
		reverse_proxy backend:8080
	}

	handle /api/* {
		reverse_proxy backend:8080
	}

	# Unsafe integration endpoints are intentionally unreachable through the
	# public reverse proxy, even if they are enabled inside the Compose network
	# for an isolated load-test environment.
	handle /internal/v1/payment-events {
		respond 404
	}

	handle /internal/v1/products/*/stock-adjustments {
		respond 404
	}

	handle /internal/* {
		reverse_proxy backend:8080
	}

	handle /grafana {
		redir /grafana/ 308
	}

	handle /grafana/* {
		reverse_proxy grafana:3000
	}

	handle_path /loadtest-runner/* {
		reverse_proxy loadtest-runner:8081
	}

	# Container logs are available only on the host-bound Dozzle port.
	# Never expose them through the public application origin.
	handle /dozzle {
		respond 404
	}

	handle /dozzle/* {
		respond 404
	}

	handle {
		reverse_proxy frontend:80
	}
}
