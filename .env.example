GOODQUEUE_MODE=postgres
GOODQUEUE_HTTP_ADDRESS=:8080
GOODQUEUE_HTTP_READ_HEADER_TIMEOUT=5s
GOODQUEUE_DOZZLE_PORT=9999
GOODQUEUE_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
GOODQUEUE_POSTGRES_DB=goodqueue
GOODQUEUE_POSTGRES_USER=goodqueue
GOODQUEUE_POSTGRES_PASSWORD=goodqueue-local
GOODQUEUE_DATABASE_URL=postgres://goodqueue:goodqueue@localhost:5432/goodqueue?sslmode=disable
GOODQUEUE_SHUTDOWN_TIMEOUT=10s
GOODQUEUE_DATABASE_PING_TIMEOUT=2s
GOODQUEUE_DATABASE_MAX_OPEN_CONNS=20
GOODQUEUE_DATABASE_MAX_IDLE_CONNS=10
GOODQUEUE_DATABASE_CONN_MAX_LIFETIME=30m
GOODQUEUE_LOG_LEVEL=info
GOODQUEUE_INVITATION_TTL=10m
GOODQUEUE_CHECKOUT_TTL=5m
GOODQUEUE_WAITING_BUFFER_PERCENT=100
# Experimental feedback loop. The static percentage above remains the startup
# value and fallback whenever Prometheus data is unavailable or unsafe.
GOODQUEUE_ADAPTIVE_QUEUE_ENABLED=false
GOODQUEUE_ADAPTIVE_QUEUE_INTERVAL=1m
GOODQUEUE_ADAPTIVE_QUEUE_MIN_HTTP_REQUESTS=100
GOODQUEUE_ADAPTIVE_QUEUE_MIN_CHECKOUT_OUTCOMES=20
GOODQUEUE_ADAPTIVE_QUEUE_MIN_HTTP_SUCCESS_PERCENT=95
GOODQUEUE_ADAPTIVE_QUEUE_MIN_BUFFER_PERCENT=0
GOODQUEUE_ADAPTIVE_QUEUE_MAX_BUFFER_PERCENT=500
GOODQUEUE_ADAPTIVE_QUEUE_MAX_STEP_PERCENT=25
GOODQUEUE_WORKER_INTERVAL=1s
GOODQUEUE_RECONCILIATION_TRANSITION_BATCH_SIZE=100
GOODQUEUE_MAX_PRODUCTS_PER_CYCLE=100
GOODQUEUE_MAX_OUTBOX_ITEMS_PER_CYCLE=100
GOODQUEUE_OUTBOX_LEASE_DURATION=30s
GOODQUEUE_OUTBOX_RETRY_BASE_DURATION=5s
GOODQUEUE_OUTBOX_RETRY_MAX_DURATION=15m
GOODQUEUE_PUBLISHER_TIMEOUT=5s
GOODQUEUE_UNSAFE_PAYMENT_CALLBACK=false
GOODQUEUE_UNSAFE_STOCK_ADJUSTMENT=false
GOODQUEUE_RECOMMENDATIONS_AI_ENABLED=false
GOODQUEUE_OPENAI_API_KEY=
GOODQUEUE_OPENAI_BASE_URL=https://api.openai.com/v1
GOODQUEUE_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
GOODQUEUE_OPENAI_EMBEDDING_TIMEOUT=8s
# Prometheus is provided by loadtest/compose.loadtest.yaml; this controls the
# request-success and purchase-success endpoint aggregation window.
GOODQUEUE_LOADTEST_SUCCESS_RATE_WINDOW=30m
