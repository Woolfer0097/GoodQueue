# GoodQueue load testing. Copy this file to loadtest/.env before using Make.
# Values explicitly exported in the shell take precedence over this file.

# PostgreSQL used by Compose, seed and verifier. Keep the password identical to
# the value used by the main Compose environment.
GOODQUEUE_POSTGRES_DB=goodqueue
GOODQUEUE_POSTGRES_USER=goodqueue
GOODQUEUE_POSTGRES_PASSWORD=goodqueue
GOODQUEUE_POSTGRES_PORT=5432

# Runner/Grafana UI defaults. The UI creates LOADTEST_RUN_ID itself; the value
# below is used only by manual CLI seed/k6/verifier commands.
LOADTEST_PROFILE=smoke
LOADTEST_SCENARIO=queue_join_polling
LOADTEST_RUN_ID=local
LOADTEST_KEEP_DATA=true
LOADTEST_RANDOM_SEED=42

# Host-side URLs used by the legacy manual CLI flow.
LOADTEST_BASE_URL=http://localhost:8088
LOADTEST_DATABASE_URL=postgres://goodqueue:goodqueue-local@localhost:5432/goodqueue?sslmode=disable
LOADTEST_RESULTS_DIR=loadtest/results
# LOADTEST_DATA_FILE=/absolute/path/to/data.json

# Profile defaults are set in code. Uncomment only to override smoke/medium/main.
# LOADTEST_USERS=10
# LOADTEST_PRODUCTS=5
# LOADTEST_PRODUCTS_PER_USER=2
# LOADTEST_RAMP_DURATION=30s
# LOADTEST_POLL_DURATION=1m
LOADTEST_POLL_INTERVAL=10s
LOADTEST_OUTCOME_TIMEOUT=7m

# Seed data generation.
LOADTEST_QUEUE_CAPACITY=1000
LOADTEST_DUPLICATE_JOIN_PERCENT=10
LOADTEST_MIN_STOCK=1
LOADTEST_MAX_STOCK=20
LOADTEST_CLEANUP_BEFORE_SEED=false
# LOADTEST_SOURCE=cli

# Prometheus and Grafana. Change Grafana credentials outside a trusted local machine.
LOADTEST_PROMETHEUS_PORT=9090
LOADTEST_PROMETHEUS_RETENTION=30d
LOADTEST_GRAFANA_ADMIN_USER=admin
LOADTEST_GRAFANA_ADMIN_PASSWORD=admin
# The one public origin used by Caddy, Grafana and Canvas runner buttons.
# On a server use, for example: https://....
GOODQUEUE_PUBLIC_URL=http://localhost:8088

# Host-k6 Remote Write settings. Runner and Docker-k6 use their internal
# Compose URLs configured below instead.
K6_PROMETHEUS_RW_SERVER_URL=http://localhost:9090/api/v1/write
K6_PROMETHEUS_RW_TREND_STATS="avg,min,max,p(90),p(95),p(99)"
K6_PROMETHEUS_RW_STALE_MARKERS=false
K6_WEB_DASHBOARD=false
K6_WEB_DASHBOARD_OPEN=false

# Browser access to the dev-only runner through Caddy.
LOADTEST_RUNNER_ENABLED=true
LOADTEST_RUNNER_API_KEY=
LOADTEST_RUNNER_CORS_ALLOWED_ORIGINS=http://localhost:8088,http://127.0.0.1:8088

# Настроить как UID:GID
#UID — идентификатор пользователя GID — идентификатор его основной группы
LOADTEST_DOCKER_USER=1000:1000

# Internal Docker-network endpoints. Usually leave them unchanged.
LOADTEST_DOCKER_BASE_URL=http://backend:8080
LOADTEST_DOCKER_PROMETHEUS_URL=http://prometheus:9090/api/v1/write
LOADTEST_RUNNER_ADDRESS=:8081
LOADTEST_RUNNER_BASE_URL=http://backend:8080
LOADTEST_RUNNER_DATABASE_URL=postgres://goodqueue:goodqueue-local@postgres:5432/goodqueue?sslmode=disable
LOADTEST_RUNNER_PROMETHEUS_WRITE_URL=http://prometheus:9090/api/v1/write
LOADTEST_RUNNER_GENERATED_DIR=/work/loadtest/generated
LOADTEST_RUNNER_RESULTS_DIR=/work/loadtest/results
LOADTEST_RUNNER_SCRIPTS_DIR=/work/loadtest/k6
LOADTEST_RUNNER_K6_BINARY=k6
LOADTEST_RUNNER_SEED_BINARY=loadtest-seed
LOADTEST_RUNNER_VERIFIER_BINARY=loadtest-verify

# Backend reads these only for load-test success/conversion endpoints and the
# adaptive queue controller. In Compose, its Prometheus URL is fixed internally.
GOODQUEUE_LOADTEST_PROMETHEUS_URL=http://prometheus:9090
GOODQUEUE_LOADTEST_SUCCESS_RATE_WINDOW=30m
