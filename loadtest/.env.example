# Profile defaults: smoke | medium | main. Explicit values below override it.
LOADTEST_PROFILE=smoke
LOADTEST_BASE_URL=http://localhost:8080
LOADTEST_DATABASE_URL=postgres://goodqueue:goodqueue@localhost:5432/goodqueue?sslmode=disable

LOADTEST_RUN_ID=local
LOADTEST_RANDOM_SEED=42

LOADTEST_USERS=10
LOADTEST_PRODUCTS=5
LOADTEST_PRODUCTS_PER_USER=2

LOADTEST_RAMP_DURATION=30s
LOADTEST_POLL_INTERVAL=10s
LOADTEST_POLL_DURATION=1m

# Planning cap per product. The backend's actual waiting capacity is derived from
# allocatable_stock and GOODQUEUE_WAITING_BUFFER_PERCENT; there is no DB column.
LOADTEST_QUEUE_CAPACITY=1000
LOADTEST_DUPLICATE_JOIN_PERCENT=10
LOADTEST_MIN_STOCK=1
LOADTEST_MAX_STOCK=20

LOADTEST_CLEANUP_BEFORE_SEED=false
LOADTEST_KEEP_DATA=true

# Go paths are repository-root-relative. For a direct k6 invocation, use an
# absolute LOADTEST_DATA_FILE or keep k6's default ../generated/data.json.
LOADTEST_DATA_FILE=loadtest/generated/data.json
LOADTEST_RESULTS_DIR=loadtest/results
