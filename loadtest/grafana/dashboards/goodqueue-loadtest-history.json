{
  "annotations": { "list": [] },
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "values": false }, "textMode": "value_and_name" },
      "targets": [{ "editorMode": "code", "expr": "sum(last_over_time(k6_http_reqs_total{testid=~\"$runId\"}[$__range])) or vector(0)", "legendFormat": "requests", "refId": "A" }],
      "title": "TOTAL REQUESTS",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent" }, "overrides": [] },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "values": false }, "textMode": "value_and_name" },
      "targets": [{ "editorMode": "code", "expr": "100 * sum(last_over_time(k6_http_reqs_total{testid=~\"$runId\",expected_response=\"true\"}[$__range])) / clamp_min(sum(last_over_time(k6_http_reqs_total{testid=~\"$runId\"}[$__range])), 1)", "legendFormat": "success", "refId": "A" }],
      "title": "HTTP SUCCESS",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "values": false }, "textMode": "value_and_name" },
      "targets": [{ "editorMode": "code", "expr": "1000 * max(last_over_time(k6_http_req_duration_p95{testid=~\"$runId\"}[$__range])) or vector(0)", "legendFormat": "p95", "refId": "A" }],
      "title": "LATENCY P95",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent" }, "overrides": [] },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "values": false }, "textMode": "value_and_name" },
      "targets": [{ "editorMode": "code", "expr": "100 * (sum(last_over_time(k6_purchased_outcomes_total{testid=~\"$runId\"}[$__range])) or vector(0)) / clamp_min((sum(last_over_time(k6_purchased_outcomes_total{testid=~\"$runId\"}[$__range])) or vector(0)) + (sum(last_over_time(k6_cancelled_outcomes_total{testid=~\"$runId\"}[$__range])) or vector(0)) + (sum(last_over_time(k6_checkout_expired_outcomes_total{testid=~\"$runId\"}[$__range])) or vector(0)), 1)", "legendFormat": "conversion", "refId": "A" }],
      "title": "PURCHASE CONVERSION",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 5 },
      "id": 5,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [{ "editorMode": "code", "expr": "sum(rate(k6_http_reqs_total{testid=~\"$runId\"}[$__rate_interval]))", "legendFormat": "RPS", "refId": "A" }],
      "title": "REQUEST RATE",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 5 },
      "id": 6,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        { "editorMode": "code", "expr": "sum(k6_vus{testid=~\"$runId\"})", "legendFormat": "VUs", "refId": "A" },
        { "editorMode": "code", "expr": "sum(rate(k6_unexpected_5xx_total{testid=~\"$runId\"}[$__rate_interval]))", "legendFormat": "unexpected 5xx/s", "refId": "B" }
      ],
      "title": "VUS / ERRORS",
      "type": "timeseries"
    }
  ],
  "refresh": "10s",
  "schemaVersion": 41,
  "tags": ["goodqueue", "k6", "history"],
  "templating": {
    "list": [
      {
        "current": {},
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "label_values(k6_http_reqs_total{keep_data=\"true\"}, testid)",
        "label": "Сохранённый Run ID",
        "name": "runId",
        "options": [],
        "query": { "query": "label_values(k6_http_reqs_total{keep_data=\"true\"}, testid)", "refId": "PrometheusVariableQueryEditor-HistoryRunId" },
        "refresh": 1,
        "sort": 3,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-30d", "to": "now" },
  "timepicker": { "refresh_intervals": ["10s", "30s", "1m"], "time_options": ["1h", "24h", "7d", "30d"] },
  "timezone": "browser",
  "title": "GoodQueue Load Test History",
  "uid": "goodqueue-loadtest-history",
  "version": 1
}
